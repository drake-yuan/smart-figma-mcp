  "bin": {
    "smart-figma-mcp": "./bin/cli.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "keygen": "node tools/keygen.js",
    "issue": "node tools/issue-license.js",
    "test": "node test/smoke.mjs"
  },
  "files": [
    "src/",
    "bin/",
    "keys/public.pem",
    "tools/keygen.js",
    "tools/quota-server.js",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
